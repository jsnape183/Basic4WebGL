{
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".", // or "./" depending on where your root folder is
    "paths": {
      "@CompilerLib/*": ["src/lib/CompilerLib/*"],
      "@Basic4WebGL/*": ["src/lib/Basic4WebGL/*"]
    },
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "src", "tests/**/*.ts"]
}
